{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Artículos y perfumes del inventario de VARIEDADES CS",
      "type": "object",
      "properties": {
        "codigo": {
          "type": "string",
          "description": "Código de barras o código interno del producto"
        },
        "producto": {
          "type": "string",
          "description": "Nombre o descripción del producto"
        },
        "categoria": {
          "type": "string",
          "description": "Categoría (Perfumería, Cosméticos, etc.)"
        },
        "precioVenta": {
          "type": "number",
          "description": "Precio de venta al público"
        },
        "precioCosto": {
          "type": "number",
          "description": "Precio de costo de adquisición"
        },
        "existencia": {
          "type": "number",
          "description": "Stock o cantidad disponible"
        },
        "marca": {
          "type": "string",
          "description": "Marca del perfume o producto"
        },
        "imagen": {
          "type": "string",
          "description": "URL de la imagen del producto"
        }
      },
      "required": ["codigo", "producto", "precioVenta", "existencia"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Registro de ventas de VARIEDADES CS",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "numeroVenta": { "type": "string" },
        "fecha": { "type": "string" },
        "cliente": { "type": "string" },
        "idCliente": { "type": "string" },
        "formaPago": { "type": "string" },
        "total": { "type": "number" },
        "estado": { "type": "string" }
      },
      "required": ["numeroVenta", "fecha", "total", "formaPago"]
    },
    "Credit": {
      "title": "Credit",
      "description": "Cuentas por cobrar y créditos otorgados",
      "type": "object",
      "properties": {
        "numeroCredito": { "type": "string" },
        "numeroVenta": { "type": "string" },
        "fecha": { "type": "string" },
        "cliente": { "type": "string" },
        "idCliente": { "type": "string" },
        "totalCredito": { "type": "number" },
        "abonado": { "type": "number" },
        "saldo": { "type": "number" },
        "vencimiento": { "type": "string" },
        "estado": { "type": "string" }
      },
      "required": ["numeroCredito", "cliente", "totalCredito", "saldo", "estado"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Abonos y pagos a créditos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "numeroCredito": { "type": "string" },
        "fecha": { "type": "string" },
        "cliente": { "type": "string" },
        "monto": { "type": "number" },
        "metodoPago": { "type": "string" }
      },
      "required": ["id", "numeroCredito", "monto", "fecha"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Clientes registrados en el sistema",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "telefono": { "type": "string" },
        "direccion": { "type": "string" },
        "email": { "type": "string" },
        "limiteCredito": { "type": "number" }
      },
      "required": ["id", "nombre"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Proveedores de mercancía",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "contacto": { "type": "string" },
        "telefono": { "type": "string" }
      },
      "required": ["id", "nombre"]
    },
    "CashMovement": {
      "title": "CashMovement",
      "description": "Movimientos de flujo de caja chica",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fecha": { "type": "string" },
        "tipo": { "type": "string" },
        "concepto": { "type": "string" },
        "monto": { "type": "number" },
        "usuario": { "type": "string" },
        "saldo": { "type": "number" }
      },
      "required": ["id", "fecha", "tipo", "monto", "saldo"]
    }
  },
  "firestore": {
    "/productos/{productoId}": {
      "schema": "Product",
      "description": "Catálogo de productos e inventario"
    },
    "/ventas/{ventaId}": {
      "schema": "Sale",
      "description": "Historial de ventas y comprobantes"
    },
    "/creditos/{creditoId}": {
      "schema": "Credit",
      "description": "Créditos otorgados y saldos pendientes"
    },
    "/abonos/{abonoId}": {
      "schema": "Payment",
      "description": "Historial de abonos a cuentas de crédito"
    },
    "/clientes/{clienteId}": {
      "schema": "Customer",
      "description": "Directorio de clientes y límites de crédito"
    },
    "/proveedores/{proveedorId}": {
      "schema": "Supplier",
      "description": "Directorio de proveedores mayoristas"
    },
    "/caja/{cajaId}": {
      "schema": "CashMovement",
      "description": "Registro de ingresos, egresos y arqueo de caja"
    }
  }
}
